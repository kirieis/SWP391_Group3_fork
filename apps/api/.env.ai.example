# ==============================================================================
# GenAI Config (Owner: Huy - Phân hệ 3)
# Tham chiếu: SRS NFR-05, R-02, NFR-07
# ==============================================================================

# API Keys - Thay bằng key thật trong file .env (KHÔNG commit file .env lên Git)
GROQ_API_KEY=your_groq_api_key
CEREBRAS_API_KEY=your_cerebras_api_key
GEMINI_API_KEY=your_gemini_api_key

# Provider routing: primary được gọi trước, fallback gọi khi primary lỗi 429/5xx
AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDER=cerebras

# Timeout tối đa cho 1 request AI (ms). Tính toán từ NFR-07: tổng pipeline ≤ 90s
AI_REQUEST_TIMEOUT_MS=15000

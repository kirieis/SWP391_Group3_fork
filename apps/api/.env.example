# ==============================================================================
# BIẾN MÔI TRƯỜNG MẪU CHO THÀNH VIÊN NHÓM AITA (apps/api/.env.example)
# Khi clone dự án về, copy file này thành file .env và điều chỉnh nếu cần
# ==============================================================================

# Cổng chạy Backend API & WebSocket
PORT=5000

# Chuỗi kết nối Microsoft SQL Server 2019+ (MSSQL) chuẩn hóa theo SRS mục 8.1
# Mặc định nhóm thống nhất: database = aita_db, user = sa, password = 12345
# trustServerCertificate=true là bắt buộc để kết nối cục bộ không bị lỗi SSL
DATABASE_URL="sqlserver://localhost:1433;database=aita;user=YOUR_USER;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true"

# Khóa bí mật JWT dùng để mã hóa token đăng nhập
JWT_SECRET=replace_with_your_secret

# Must match queue-worker INTERNAL_API_KEY
INTERNAL_API_KEY=replace_with_same_long_random_secret
GOOGLE_CLIENT_ID=your_google_client_id

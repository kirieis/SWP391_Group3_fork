// ==============================================================================
// PRISMA SCHEMA CHO HỆ THỐNG AITA-INTELLIGENT (SWP391 - Nhóm 3)
// Cơ sở dữ liệu: Microsoft SQL Server 2019+ (MSSQL)
// Đối chiếu: SRS v1.2 Mục 6.5 (ERD) & Mục 6.6 (Data Dictionary)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// 1. BẢNG USERS: Tài khoản người dùng chung
// ==============================================================================
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?   @map("password_hash")
  fullName     String    @map("full_name")
  role         String    // "STUDENT", "LECTURER", "ADMIN"
  createdAt    DateTime  @default(now()) @map("created_at")

  // Quan hệ 1-1 với các bảng con phân quyền:
  studentProfile  Student?
  lecturerProfile Lecturer?
  adminProfile    Admin?

  // Quan hệ lịch sử sửa điểm (ScoreAuditLog trỏ tới User):
  auditLogs ScoreAuditLog[]

  @@map("users")
}

// ==============================================================================
// 2. BẢNG STUDENTS: Thông tin chi tiết sinh viên (1-1 với Users)
// ==============================================================================
model Student {
  userId      String   @id @map("user_id")
  studentCode String   @unique @map("student_code")
  major       String?
  intakeYear  Int?     @map("intake_year")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Quan hệ:
  classEnrollments ClassStudent[]
  submissions      Submission[]
  appeals          Appeal[]

  @@map("students")
}

// ==============================================================================
// 3. BẢNG LECTURERS: Thông tin chi tiết giảng viên (1-1 với Users)
// ==============================================================================
model Lecturer {
  userId        String   @id @map("user_id")
  department    String?
  title         String?
  lecturerCode  String?  @unique @map("lecturer_code")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Quan hệ:
  managedClasses Class[]
  resolvedAppeals Appeal[] @relation("LecturerResolvedAppeals")

  @@map("lecturers")
}

// ==============================================================================
// 4. BẢNG ADMINS: Thông tin chi tiết quản trị viên (1-1 với Users)
// ==============================================================================
model Admin {
  userId        String  @id @map("user_id")
  accessLevel   String? @map("access_level")
  staffCode     String? @unique @map("staff_code")
  managedScope  String? @map("managed_scope")

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

// ==============================================================================
// 5. BẢNG CLASSES: Lớp học do Giảng viên quản lý
// ==============================================================================
model Class {
  id          String         @id @default(uuid())
  classCode   String         @map("class_code")
  lecturerId  String         @map("lecturer_id")

  lecturer    Lecturer       @relation(fields: [lecturerId], references: [userId], onUpdate: NoAction)
  students    ClassStudent[]
  assignments Assignment[]

  @@map("classes")
}

// ==============================================================================
// 6. BẢNG CLASS_STUDENTS: Sinh viên thuộc lớp nào (Quan hệ N-N)
// ==============================================================================
model ClassStudent {
  classId    String   @map("class_id")
  studentId  String   @map("student_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at")
  status     String   @default("ACTIVE") @map("status") // "ACTIVE" hoặc "DROPPED"

  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [userId], onUpdate: NoAction)

  @@id([classId, studentId])
  @@map("class_students")
}


// ==============================================================================
// 7. BẢNG ASSIGNMENTS: Đề bài / Bài tập lập trình
// ==============================================================================
model Assignment {
  id              String       @id @default(uuid())
  classId         String       @map("class_id")
  title           String
  description     String?      @db.Text
  language        String       // "Java", "Python", "C#"
  deadline        DateTime
  gradingCriteria String?      @map("grading_criteria") @db.NVarChar(Max)

  class           Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  testCases       TestCase[]
  submissions     Submission[]

  @@map("assignments")
}

// ==============================================================================
// 8. BẢNG TEST_CASES: Bộ test cases chấm code trong Docker Sandbox
// ==============================================================================
model TestCase {
  id             String     @id @default(uuid())
  assignmentId   String     @map("assignment_id")
  inputData      String?    @map("input_data") @db.Text
  expectedOutput String?    @map("expected_output") @db.Text
  scoreWeight    Int        @map("score_weight")

  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("test_cases")
}

// ==============================================================================
// 9. BẢNG SUBMISSIONS: Bài nộp của sinh viên
// ==============================================================================
model Submission {
  id           String            @id @default(uuid())
  assignmentId String            @map("assignment_id")
  studentId    String            @map("student_id")
  fileUrl      String            @map("file_url")
  fileHash     String?           @map("file_hash") // SHA-256
  status       String            // "PENDING", "RUNNING_TESTS", "COMPLETED", "SCORE_WITHHELD", "COMPILATION_ERROR", "TIMEOUT", "SECURITY_VIOLATION", "FAILED"
  totalScore   Float?            @map("total_score")
  aiFeedback   String?           @map("ai_feedback") @db.Text
  submittedAt  DateTime          @default(now()) @map("submitted_at")
  // ADR-001 §5: Trạng thái pipeline kiểm tra đạo văn AST
  // PENDING = chờ, DONE = hoàn tất, FAILED = engine lỗi/timeout, NEEDS_REVIEW = fallback lex
  astCheckStatus String          @default("PENDING") @map("ast_check_status")

  assignment   Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student           @relation(fields: [studentId], references: [userId], onUpdate: NoAction)

  // Quan hệ:
  fingerprint        ASTFingerprint?
  plagiarismMatches1 PlagiarismMatch[]  @relation("Submission1Matches")
  plagiarismMatches2 PlagiarismMatch[]  @relation("Submission2Matches")
  appeal             Appeal?
  auditLogs          ScoreAuditLog[]

  // --- PERFORMANCE INDEXES (NFR-08/NFR-09) ---
  // IDX-S1: Dashboard truy vấn bài nộp theo assignment + sinh viên
  @@index([assignmentId, studentId], name: "idx_submissions_assignment_student")
  // IDX-S2: Lọc nhanh bài cần xử lý (queue worker drain)
  @@index([status, submittedAt], name: "idx_submissions_status_submitted_at")
  // IDX-S3: Top-10 bài cần review AST theo trạng thái
  @@index([astCheckStatus, assignmentId], name: "idx_submissions_ast_status_assignment")
  @@map("submissions")
}

// ==============================================================================
// 10. BẢNG AST_FINGERPRINTS: Dữ liệu vân tay AST (Trọng tâm RBL Winnowing)
// ==============================================================================
model ASTFingerprint {
  id              String     @id @default(uuid())
  submissionId    String     @unique @map("submission_id")
  fingerprintData String     @map("fingerprint_data") @db.NVarChar(Max)
  analysisMode    String?    @default("ast") @map("analysis_mode") // "ast" | "lex"
  fallbackReason  String?    @map("fallback_reason") // "SYNTAX_ERROR", "PARSER_FAILED", ...
  warnings        String?    @map("warnings") @db.NVarChar(Max) // JSON array: ["SYNTAX_ERROR_FALLBACK_LEX", ...]

  submission      Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("ast_fingerprints")
}

// ==============================================================================
// 11. BẢNG PLAGIARISM_MATCHES: Kết quả so khớp đạo văn giữa 2 bài nộp
// ==============================================================================
model PlagiarismMatch {
  id                String     @id @default(uuid())
  submission1Id     String     @map("submission_1_id")
  submission2Id     String     @map("submission_2_id")
  similarityPercent Float      @map("similarity_percent")
  level             String?    @map("level") // "SAFE" | "WARNING" | "DANGER"
  mode              String?    @map("mode") // "ast" | "lex"
  matchedFragments  String?    @map("matched_fragments") @db.NVarChar(Max)

  submission1       Submission @relation("Submission1Matches", fields: [submission1Id], references: [id], onUpdate: NoAction)
  submission2       Submission @relation("Submission2Matches", fields: [submission2Id], references: [id], onUpdate: NoAction)

  // ADR-001 §5: Luôn lưu id nhỏ trước (s1 < s2) để tránh trùng cặp A-B và B-A
  // Constraint này đảm bảo upsert idempotent khi retry
  @@unique([submission1Id, submission2Id], name: "submission1Id_submission2Id")
  // IDX-P1: Lecturer Dashboard Top-10: sắp xếp theo similarity giảm dần
  @@index([level, similarityPercent], name: "idx_plagiarism_level_similarity")
  // IDX-P2: Worker truy vấn match của 1 bài nộp cụ thể
  @@index([submission1Id], name: "idx_plagiarism_s1")
  @@index([submission2Id], name: "idx_plagiarism_s2")
  @@map("plagiarism_matches")
}

// ==============================================================================
// 12. BẢNG APPEALS: Đơn khiếu nại / phúc khảo điểm của sinh viên
// ==============================================================================
model Appeal {
  id               String     @id @default(uuid())
  submissionId     String     @unique @map("submission_id")
  studentId        String     @map("student_id")
  resolvedBy       String?    @map("resolved_by")
  reason           String     @db.Text
  status           String     @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  lecturerResponse String?    @map("lecturer_response") @db.Text
  createdAt        DateTime   @default(now()) @map("created_at")
  resolvedAt       DateTime?  @map("resolved_at")

  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  student          Student    @relation(fields: [studentId], references: [userId], onUpdate: NoAction)
  resolvedLecturer Lecturer?  @relation("LecturerResolvedAppeals", fields: [resolvedBy], references: [userId], onUpdate: NoAction)

  // IDX-A1: Giảng viên lọc khiếu nại Pending nhanh
  @@index([status, createdAt], name: "idx_appeals_status_created")
  @@index([studentId], name: "idx_appeals_student")
  @@map("appeals")
}

// ==============================================================================
// 13. BẢNG SCORE_AUDIT_LOGS: Nhật ký chỉnh sửa điểm (Audit Trail cho P2P Defense)
// ==============================================================================
model ScoreAuditLog {
  id           String     @id @default(uuid())
  submissionId String     @map("submission_id")
  editorId     String?    @map("editor_id")
  oldScore     Float?     @map("old_score")
  newScore     Float      @map("new_score")
  reason       String     @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  editor       User?      @relation(fields: [editorId], references: [id], onUpdate: NoAction)

  // IDX-L1: Audit trail truy vấn nhanh theo bài nộp + thời gian
  @@index([submissionId, createdAt], name: "idx_audit_submission_time")
  @@map("score_audit_logs")
}
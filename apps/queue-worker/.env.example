# ==============================================================================
# BIẾN MÔI TRƯỜNG MẪU CHO MODULE 5 — QUEUE WORKER (apps/queue-worker/.env.example)
# Copy file này thành .env và điều chỉnh nếu cần
# ==============================================================================

# ─── Redis Connection ─────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Optional: REDIS_URL takes precedence if specified (supports rediss:// for TLS)
REDIS_URL=

# ─── Worker Configuration ────────────────────────────────────────────────────
WORKER_CONCURRENCY=5

# ─── Batch Grading Queue ─────────────────────────────────────────────────────
BATCH_CONCURRENCY=2
BATCH_RATE_LIMIT_MAX=10
BATCH_RATE_LIMIT_DURATION_MS=1000

# ─── Module 1 (API Gateway) Callback ─────────────────────────────────────────
API_GATEWAY_URL=http://localhost:5000
INTERNAL_API_KEY=aita_internal_secret_key_2026

# ─── Module 2 (Docker Sandbox Engine) ────────────────────────────────────────
SANDBOX_URL=http://localhost:5001
SANDBOX_TIMEOUT_MS=30000

# ─── Module 3 (GenAI Gateway - Huy) ──────────────────────────────────────────
GENAI_GATEWAY_URL=http://localhost:5002
GENAI_TIMEOUT_MS=30000
AI_REVIEW_RETRY_DELAY_MS=30000
AI_REVIEW_MAX_RETRY_ROUNDS=3

# ─── Module 4 (AST Plagiarism Engine - Nhật) ─────────────────────────────────
AST_ENGINE_URL=http://localhost:8001
AST_TIMEOUT_MS=15000

# ─── Overall Pipeline Timeout ────────────────────────────────────────────────
PIPELINE_TIMEOUT_MS=90000

# ─── Git Analytics (US-11) ───────────────────────────────────────────────────
GIT_WORKER_CONCURRENCY=2
GIT_HOST_ALLOWLIST=github.com
GIT_CLONE_TIMEOUT_MS=60000
MAX_REPO_SIZE_MB=100
MAX_COMMITS=5000
FREE_RIDER_THRESHOLD_PERCENT=5
CONTRIBUTION_COMMIT_WEIGHT=0.5
CONTRIBUTION_LOC_WEIGHT=0.5
GIT_TEMP_DIR=./tmp/git

# ─── Mock Mode ───────────────────────────────────────────────────────────────
# Set to "true" to use in-memory mock clients (no external services needed)
USE_MOCKS=false

# ─── Logging & Runtime ───────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development

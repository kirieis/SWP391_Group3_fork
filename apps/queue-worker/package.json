{
  "name": "@aita/queue-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Module 5 — BullMQ Queue Worker & Git Analytics for AITA-Intelligent (SWP391)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "smoke": "cross-env USE_MOCKS=true tsx src/smoke.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@vitest/coverage-v8": "^2.1.9",
    "cross-env": "^7.0.3",
    "eslint": "^9.11.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.1"
  }
}

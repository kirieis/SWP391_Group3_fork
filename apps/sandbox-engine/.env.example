# Server Configuration
HOST=127.0.0.1
PORT=5001
INTERNAL_TOKEN=replace_with_same_long_random_secret

# Callback Reporter Configuration (Module 1 Integration)
CORE_API_URL=http://localhost:3000
CORE_API_KEY=replace_with_same_long_random_secret

# Concurrency & Queue Configuration
MAX_CONCURRENT_CONTAINERS=4
MAX_QUEUE_SIZE=20

# Sandbox Security & Resource Limits
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=64
SANDBOX_TMPFS_SIZE_MB=64

# Timeouts (seconds)
OVERALL_TIMEOUT_SEC=30
COMPILE_TIMEOUT_SEC=60
TEST_CASE_TIMEOUT_SEC=5

# Zip Security Limits
MAX_ZIP_SIZE_BYTES=10485760
MAX_UNCOMPRESSED_SIZE_BYTES=52428800
MAX_ZIP_FILES=200
MAX_DIR_DEPTH=10

# Output Sanitization & Truncation (bytes)
MAX_OUTPUT_BYTES=65536

# Logging & Retention
LOG_DIR=./logs
LOG_RETENTION_DAYS=30

# Sandbox Docker Images
JAVA_IMAGE=aita-sandbox-java17:latest
DOTNET_IMAGE=aita-sandbox-dotnet8:latest
